{
  "name": "@teamgrid/mcp-server",
  "version": "1.2.1",
  "description": "TeamGrid MCP adapter with read-only defaults and explicit domain write profiles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamGrid/developer-platform.git",
    "directory": "developer-platform/packages/mcp-server"
  },
  "homepage": "https://github.com/TeamGrid/developer-platform/tree/main/developer-platform/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/TeamGrid/developer-platform/issues"
  },
  "keywords": [
    "teamgrid",
    "api",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "files": [
    "dist",
    "COVERAGE.md"
  ],
  "bin": {
    "teamgrid-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "postbuild": "node -e \"const fs=require('node:fs'); fs.chmodSync('dist/bin.js', 0o755); const file='dist/generated/domainCatalog.json'; fs.writeFileSync(file, JSON.stringify(JSON.parse(fs.readFileSync(file, 'utf8'))))\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.14 <25"
  },
  "dependencies": {
    "@teamgrid/api-client": "1.2.1",
    "@teamgrid/cli": "1.2.1",
    "zod": "4.4.3",
    "@modelcontextprotocol/server": "2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
