{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "scripts/conformance/**/*.mjs",
      "scripts/build-ai-integrations.mjs",
      "scripts/check-release-documentation.mjs",
      "scripts/staging-e2e-cleanup.mjs",
      "scripts/staging-e2e-cleanup.test.mjs",
      "scripts/staging-load.mjs",
      "scripts/staging-load.test.mjs",
      "scripts/validate-release.mjs",
      "scripts/verify-production-release-evidence.mjs",
      "scripts/verify-production-release-evidence.test.mjs",
      "!packages/**/dist",
      "!packages/api-client/src/generated/schema.ts",
      "!packages/mcp-server/src/toolScopes.ts",
      "!packages/mcp-server/src/generated/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
